PORT=3000
API_KEY=change-me-in-local-env
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Harness (gemini | openai | mock)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=
SAMPLE_REPO_URL=https://github.com/LeMinhSang2k5/TodoAppCloud
SAMPLE_REPO_BRANCH=master

# Tùy chọn chia batch & gom module khi sinh tài liệu bằng AI Harness
# MAX_AI_MODULES: Số lượt batch tối đa gọi LLM cho mỗi job (mặc định 8; tăng lên 30–50 hoặc hơn cho repo lớn 100+ file)
MAX_AI_MODULES=50
# MAX_NODES_PER_DOC: Số node code_map tối đa gửi trong 1 lượt LLM để tránh tràn token (mặc định 60)
MAX_NODES_PER_DOC=60
# AI_INTER_DOC_DELAY_MS: Thời gian nghỉ (ms) giữa các lượt gọi LLM để tránh lỗi 429 Free Tier (mặc định 2500; dùng 8000 cho repo lớn)
AI_INTER_DOC_DELAY_MS=8000
# DOC_GROUPING_MODE: Cách gom tài liệu thành từng file Markdown
# - feature: Gom theo chức năng nghiệp vụ qua Call Graph
#   VD: AuthController + AuthService + AuthRequest + LoginPage -> gộp chung thành 1 file "modules/feature_auth.md"
# - folder: Gom theo tầng thư mục mã nguồn
#   VD: Tất cả file trong thư mục controllers/ -> "modules/controllers.md", services/ -> "modules/services.md"
DOC_GROUPING_MODE=feature
